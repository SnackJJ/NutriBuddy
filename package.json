{
  "scripts": {
    "sandcastle": "npx tsx .sandcastle/main.mts",
    "sandcastle:deepseek": "cp .sandcastle/.env.deepseek .sandcastle/.env && npx tsx .sandcastle/main.mts",
    "sandcastle:claude": "cp .sandcastle/.env.claude .sandcastle/.env && npx tsx .sandcastle/main.mts",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "eval": "npx tsx src/eval/index.ts",
    "eval:live": "npx tsx src/eval/live-compliance.ts"
  },
  "devDependencies": {
    "@ai-hero/sandcastle": "^0.10.0",
    "@types/node": "^26.0.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "autoprefixer": "^10.5.2",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.35",
    "postcss": "^8.5.15",
    "prettier": "^3.8.4",
    "tailwindcss": "^3.4.19",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.108.2",
    "next": "^14.2.35",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^4.4.3"
  }
}
