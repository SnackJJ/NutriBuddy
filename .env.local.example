# Supabase — 从 Supabase 项目 Settings → API 复制；真实值放入 .env.local（已 gitignore）。
#
# 公开值：随客户端下发，受 RLS 约束。
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# 私密值：仅服务端使用，绕过 RLS，绝不下发到浏览器。
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# 模型（harness ModelAdapter 使用）。供应商是配置（src/harness/modelAdapter.ts 的
# PROVIDER_PROFILES），不设 NUTRIBUDDY_MODEL_PROVIDER 即直连 DeepSeek。
DEEPSEEK_API_KEY=your-deepseek-api-key

# 经 OpenAI 兼容网关（如 Command Code）调用时：
# NUTRIBUDDY_MODEL_PROVIDER=commandcode
# COMMANDCODE_API_KEY=your-gateway-api-key
# 单项覆盖（任何供应商都可用）：
# NUTRIBUDDY_MODEL_BASE_URL=...
# NUTRIBUDDY_MODEL_FLASH=...
# NUTRIBUDDY_MODEL_PRO=...
# NUTRIBUDDY_MODEL_SENDS_THINKING=false   # 网关拒绝未知字段时

# USDA FoodData Central（get_food_nutrition 工具使用）。
# 免费注册获取：https://fdc.nal.usda.gov/api-key-signup.html
USDA_API_KEY=your-usda-api-key

# Query runner（issue #64）：设为 sql 时经 SELECT-only 角色执行 reviewed SQL
# （需已应用 supabase/migrations/0008）；不设则用 in-memory runner（CI 默认）。
# NUTRIBUDDY_QUERY_RUNNER=sql

# Catalog 快照（issue #60）：指向 ingestion 输出文件时按其版本加载；不设则用 seed。
# CATALOG_SNAPSHOT_PATH=./catalog-snapshot.json

# 配额（RFC 0010 §3.3 / issue #97-#99）。不设即用代码内默认（40 / 1 / 0.5，见
# src/lib/quota.ts 的 QUOTA_DEFAULT_LIMITS）；值读不出来时也回落到默认，不会变成无限。
# 设成 0 表示该维度一律拒绝。日界按 UTC，超限返回 429 + typed body。
# QUOTA_DAILY_TURNS=40
# QUOTA_DAILY_COST_USD=1
# QUOTA_MAX_TURN_COST_USD=0.5

# 注册入口（RFC 0010 §3.2 方案 A / issue #102）不再有自己的开关：/profile 直接读
# Supabase Auth 的公开设置（GET /auth/v1/settings 的 disable_signup），所以「关闭公开注册」
# 这一个 Dashboard 开关就是唯一真源（读不到时按关闭渲染）。加人走
# scripts/create-user.mts（见 docs/ops/v1.0-operations.md）。
